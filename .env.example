# Google OAuth 2.0 Client ID untuk Google Identity Services
# Buat di Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Tipe aplikasi: Web application
# Authorized JavaScript origins: http://localhost:3000, http://127.0.0.1:3000, atau domain hosting Anda
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Firebase Cloud Firestore (Opsional untuk Sinkronisasi Multi-Device)
# Buat di Firebase Console: https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
